{
  "name": "lebflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:laravel": "npm run build:api && node scripts/publish-frontend.cjs",
    "backend:dev": "node scripts/serve-backend.cjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/service-details.test.cjs",
    "test:browser": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "dev:api": "vite --mode api --host 127.0.0.1 --port 5176 --strictPort",
    "build:api": "tsc -b && vite build --mode api",
    "test:backend-browser": "npm run build:laravel && playwright test --config playwright.backend.config.ts",
    "catalog:export": "node scripts/export-service-catalog.cjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "prettier": "^3.6.2",
    "typescript": "5.7.2",
    "vite": "6.4.3"
  }
}
