{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:api",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    },
    {
      "source": "/sanctum/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://lebflow-backend.onrender.com/api/:path*" },
    {
      "source": "/sanctum/:path*",
      "destination": "https://lebflow-backend.onrender.com/sanctum/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
